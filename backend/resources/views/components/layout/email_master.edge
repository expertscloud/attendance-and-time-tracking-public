@mjml()
  <mjml>
    <mj-head>
      <mj-attributes>
        <mj-all font-family="'Barlow', 'Helvetica', 'Arial', sans-serif">
        </mj-all>
        <mj-button background-color="#0D4680">
        </mj-button>
      </mj-attributes>
      <mj-font
        href="https://fonts.googleapis.com/css?family=Barlow:normal,italic,bold&display=swap"
        name="Barlow"
      >
      </mj-font>
    </mj-head>

    <mj-body width="600px" background-color="#E7F1F3">
      <mj-text font-size="0px">
        {{ new Date().getTime() }}
      </mj-text>

      {{-- add header --}}
      <mj-section padding="0px">
        <mj-column padding="0">
          <mj-spacer height="32px">
          </mj-spacer>
        </mj-column>
      </mj-section>
      <mj-section background-color="#ffffff" padding="30px 48px">
        <mj-column padding="0">
          <mj-image
            align="center"
            padding="0px"
            src="https://......s3.us-east-1.amazonaws.com/public-logos/tickly-logo.png"
            width="180px"
          >
          </mj-image>
        </mj-column>
      </mj-section>

      {{{ await $slots.content() }}}
      <mj-text font-size="0px">
        {{ new Date().getTime() }}
      </mj-text>

      {{-- add footer --}}
    </mj-body>
  </mjml>
@end
