# Copy to .env before running Docker Compose:
#   cp .env.example .env
#
# Then:
#   docker compose up --build
#
# AWS S3 is required for profile-photo uploads.

## AWS S3
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
AWS_S3_SIGNED_URL_EXPIRY_DAYS=4 days

# Do not set AWS_ENDPOINT for real AWS S3.
# (That var is only for S3-compatible local services.)
