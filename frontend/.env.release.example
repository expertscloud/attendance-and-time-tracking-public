# Copy this file before building a release:
#   cp .env.release.example .env.release
#
# Then run (from frontend/):
#   docker build -f Dockerfile.release -t my-release-image .
#   docker run --rm --env-file .env.release -v ./release:/app/release my-release-image
#
# These values are baked into the desktop app at build time.

VITE_BACKEND_URL=http://localhost:3333
VITE_FRONTEND_URL=http://localhost:3000

# Optional — needed for geolocation on Windows/Linux installers
VITE_GOOGLE_API_KEY=
